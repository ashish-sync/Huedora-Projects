# Backend API origin (no trailing slash).
# Local Vite: leave empty to use the /api proxy in vite.config.js (default → localhost:5000).
# Render production (set in Render dashboard for Huedora-Projects):
# VITE_BACKEND_URL=https://huedora-projects-server.onrender.com
VITE_BACKEND_URL=

# Camp One talks to TYLO /api/v1/camp-ops using the same session as the rest of the app.
# No extra Camp One frontend env vars are required when using the Vite proxy.

# Google Maps Places API key for Camp address autocomplete (Create Camp form).
# Enable "Maps JavaScript API" and "Places API (New)" in Google Cloud Console.
# Optional if GOOGLE_MAPS_API_KEY is set on the API server (loaded at runtime).
# VITE_GOOGLE_MAPS_API_KEY=

# ── Cinematic login (terminal boot) ─────────────────────────────────────────
# Set VITE_LOGIN_CINEMATIC=false to restore classic sign-in → home (no boot screen).
# Sub-flags apply when cinematic is on (override individually in Render env vars).
# VITE_LOGIN_CINEMATIC=true
# VITE_LOGIN_BOOT_SEQUENCE=true
# VITE_LOGIN_FULLSCREEN=true
# VITE_LOGIN_HEALTH_INSIGHTS=true
# VITE_LOGIN_DARK_AFTER_BOOT=true

# Demo-only UX (communications re-extract). Leave unset/false in production.
# VITE_DEMO_SERVER=false
