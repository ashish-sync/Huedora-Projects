{
  "name": "tylo-one-client",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "brand:assets": "node scripts/generate-brand-assets.mjs",
    "lint": "eslint .",
    "lint:actions": "eslint src/features/camps/utils/campExecutionActions.js src/features/camps/utils/campAssignmentActions.js src/features/camps/utils/campBulkActions.js src/features/camps/utils/campCancelRefuse.js src/features/camps/components/CampExecutionRowActions.jsx src/features/camps/components/CampAssignmentRowActions.jsx src/features/camps/constants/campLifecycle.js",
    "lint:camps": "eslint src/features/camps",
    "test": "vitest run",
    "test:camps": "vitest run src/features/camps",
    "verify": "npm run lint && npm run test",
    "verify:camps": "npm run lint:actions && npm run test:camps",
    "preview": "vite preview"
  },
  "dependencies": {
    "docx-preview": "^0.4.0",
    "html2pdf.js": "^0.14.0",
    "lucide-react": "^1.25.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1",
    "react-select": "^5.10.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.49.0",
    "postcss": "^8.5.23",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.19",
    "vite": "^6.0.6",
    "vitest": "^4.1.10"
  }
}
